# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Anthropic API key for AI work simulations (https://console.anthropic.com/settings/keys).
# While this is the placeholder, AI features are off and the app uses its built-in sample simulations.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Claude model used to generate and run simulations.
ANTHROPIC_MODEL=claude-opus-5-5

# Origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Signal engine (backend/pipeline, served at /api/signals) ----

# Gemini key for reading CVs (/api/signals/profile/extract), https://aistudio.google.com/apikey.
# Without it, CVs are read with the skills dictionary only.
GEMINI_API_KEY=

# JSearch key for live job openings in each role's "Open jobs" panel (Google for Jobs listings, Malaysia).
# RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (free plan: 200 requests a month; searches are
# cached for a day). Without it, the panel links to the job boards instead.
JSEARCH_API_KEY=

# Tavily key for free courses in The Route's learning plan (https://tavily.com: free plan, 1,000 credits a month, no
# card). It searches free learning sites only (MIT OpenCourseWare, freeCodeCamp, Khan Academy, Microsoft Learn...).
# Without it, the plan uses Coursera and the curated courses only. KOMPAS_TAVILY=0 switches it off.
TAVILY_API_KEY=

# Google sign-in: an OAuth client ID (public, not a secret). Google Cloud Console > APIs & Services > Credentials >
# Create OAuth client ID > Web application, with http://localhost:3000 under "Authorized JavaScript origins".
# Put the same ID in frontend/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID. Without it, the Google button is hidden.
GOOGLE_CLIENT_ID=

# GitHub token for ingestion: fine-grained, public repositories, read-only
# (https://github.com/settings/personal-access-tokens). Without it the search API allows 10 requests/min instead of 30.
GITHUB_TOKEN=

# 1 = poll Hacker News and GitHub while the server runs (the live feed); 0 = serve stored data only.
KOMPAS_LIVE=0
# 1 = re-stream recorded feed events, so a demo always has movement.
KOMPAS_REPLAY=0

# Postgres (Supabase) for the signal engine: Dashboard > Connect > Session pooler (port 5432). Percent-encode special
# characters in the password. Empty = the local SQLite file at backend/data/kompas.db.
# Move a local database over once with: .venv/bin/kompas copy-to-postgres
DATABASE_URL=

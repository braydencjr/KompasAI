# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Anthropic API key for AI work simulations (https://console.anthropic.com/settings/keys).
# While this is the placeholder, AI features are off and the app uses its built-in sample simulations.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Claude model used to generate and run simulations.
ANTHROPIC_MODEL=claude-opus-5-5

# Origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
